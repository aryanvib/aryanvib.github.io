@inproceedings{bhosale2026vibe,
      abbr={EMNLP},
      title={VIBE: Video Instruction-aligned Background Music Generation},
      author={Aryan Vijay Bhosale and Vaibhavi Lokegaonkar and Vishnu Raj and Gouthaman KV and Sreyan Ghosh and Ramani Duraiswami and Lie Lu and Dinesh Manocha},
      booktitle={EMNLP (Findings) 2026},
      year={2026},
      preview={vibe.png},
      selected={true},
      abstract={A text-and-video-to-music generation model that brings semantic control and instruction adherence to video-to-music. VIBE introduces a depth-wise cross-layer conditioning mechanism to overcome the representational bottleneck of static cross-modal conditioning in diffusion-autoregressive architectures, together with a reward-modeling taxonomy that optimizes both verifiable constraints (tempo, key) and subjective qualities (musicality, multimodal alignment) through a five-stage training curriculum.},
      arxiv={2608.30125},
      website={https://vibe-text-video-to-music-generation.github.io/vibe/},
}

@misc{bhosale2026duplexworld,
      abbr={Preprint},
      title={DuplexWorld: Can Voice Agents Help You Get Through the Day?},
      author={Aryan Vijay Bhosale and Harshit Rajgarhia and Akhil Pothanapalli and Asif Shaik and Abhishek Mukherji and Dinesh Manocha},
      year={2026},
      preview={duplexworld.png},
      selected={true},
      abstract={A benchmark for holistically evaluating speech-to-speech voice agents beyond database tool-calling. DuplexWorld spans six domains where voice agents are especially useful, with agents evaluated on eleven conversation types across 156 scenarios (350+ hours of dialogue), each probing conversational and analytical ability.},
      arxiv={2608.10716},
      website={https://duplexworld.github.io/},
      preview_shot={duplexworld.png},
}

@inproceedings{bhosale2026torus,
      abbr={EMNLP},
      title={TORUS: A Test of Rendering-Understanding Self-Coherence for Unified Audio Models},
      author={Aryan Vijay Bhosale and Harshit Rajgarhia and Abhishek Mukherji and Dinesh Manocha},
      booktitle={EMNLP 2026 Workshop on Speech and Audio Language Models (SALMA)},
      year={2026},
      preview={torus.png},
      selected={true},
      abstract={The first self-coherence test for audio-native unified models, asking whether a model's generation and understanding heads agree about the same audio rather than evaluating each capability in isolation. TORUS comprises 48 three-stage self-coherence tests with 432 six-option questions spanning speech, sound, and music across five task families.},
      arxiv={2607.28896},
      website={https://torus-benchmark.github.io/},
}

